{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (NestJS)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 3001,
      "env": {
        "PORT": "3001",
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Admin Portal (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 3000,
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Mobile (Expo)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mobile"],
      "port": null,
      "env": {
        "EXPO_DEVTOOLS_LISTEN_ADDRESS": "0.0.0.0"
      }
    }
  ]
}
