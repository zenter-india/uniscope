{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (NestJS)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 3001,
      "env": {
        "PORT": "3001",
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Admin Portal (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 3000,
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Mobile (Flutter Web)",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd /Users/kiranrajr/uniscope/mobile_flutter && exec /opt/homebrew/bin/flutter run -d web-server --web-hostname 127.0.0.1 --web-port 8080 --dart-define=API_URL=http://localhost:3001"
      ],
      "port": 8080
    }
  ]
}
