// Uniscope — Production Prisma Schema
// M1: Core Infrastructure & Data Layer
//
// Notes:
//   • PKs use uuid() — optimal for Supabase/PostgreSQL.
//   • datasource has no `url` field; Prisma 7 reads DATABASE_URL and DIRECT_URL
//     from prisma.config.ts. DIRECT_URL bypasses the Supabase pgBouncer pooler
//     for migrations (required when DATABASE_URL uses port 6543).
//   • searchVector (tsvector) fields are marked Unsupported — a raw SQL migration
//     creates the GENERATED ALWAYS AS STORED column and GIN indexes.
//   • All table/column names follow snake_case PostgreSQL convention via @@map / @map.
//   • Money is always stored as integer minor units (paise) — never floats.
//   • LedgerEntry is append-only: never UPDATE/DELETE a row. Corrections are new
//     compensating entries. Wallet.balanceMinor is a cache, always written in the
//     same DB transaction as the ledger insert that produced it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ASPIRANT
  MENTOR
  ADMIN
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum UniversityType {
  GOVERNMENT
  PRIVATE
  DEEMED
  CENTRAL
}

enum DocumentType {
  STUDENT_ID
  STUDENT_PORTAL_SCREENSHOT
  DEGREE_CERTIFICATE
  NMC_REGISTRATION
}

enum ReviewStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum NotificationType {
  MESSAGE
  SESSION_REQUEST
  SESSION_ACCEPTED
  SESSION_REJECTED
  SESSION_STARTING
  SESSION_ENDED
  LOW_BALANCE
  PAYMENT
  REVIEW
  VERIFICATION
  SYSTEM
}

enum ReportTargetType {
  SESSION
  REVIEW
  MESSAGE
  USER
}

enum ReportReason {
  SPAM
  MISINFORMATION
  HARASSMENT
  IMPERSONATION
  INAPPROPRIATE
  ABUSIVE_LANGUAGE
  /// Counterparty asked to be paid/contacted outside the platform.
  OFF_PLATFORM_PAYMENT_REQUEST
  /// Mentor/aspirant-side disconnect mid-AUDIO_CALL — surfaces reports for
  /// the manual admin refund review described on Session.endReason.
  CALL_DROPPED
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

/// Chat = Stream Chat text session. AudioCall = Agora voice session.
/// Video is out of scope by deliberate product decision (anonymity model).
enum SessionType {
  CHAT
  AUDIO_CALL
}

/// Full booking + call lifecycle. Billing only ever runs while IN_PROGRESS,
/// and only the backend (never the client) may transition into/out of it.
enum SessionStatus {
  PENDING // booking created, awaiting mentor response
  ACCEPTED // mentor accepted; audio calls move to RINGING, chat moves to IN_PROGRESS
  REJECTED // mentor declined
  RINGING // audio call only: callee is being rung (FCM data push sent)
  IN_PROGRESS // active — chat ongoing, or call connected (server-confirmed via Agora webhook)
  COMPLETED // ended normally, final billing true-up applied
  CANCELLED // aspirant cancelled before mentor responded / before start
  EXPIRED // mentor never responded within the response window
  FAILED // no-answer or connection failure before a billable connection occurred
}

enum LedgerEntryType {
  TOPUP // aspirant purchased Uniminutes (via Razorpay)
  SESSION_DEBIT // aspirant charged for session minutes (provisional or true-up)
  SESSION_CREDIT // mentor earned from session minutes
  REFUND // reversal to aspirant
  HOLD_RELEASE // unused hold amount returned to spendable balance
  ADJUSTMENT // manual admin correction — always paired with an audit note
  PAYOUT // mentor earnings debited on a COMPLETED PayoutRequest (bank transfer sent)
}

enum HoldStatus {
  ACTIVE // funds reserved, session in progress
  CONSUMED // fully absorbed into SESSION_DEBIT entries at session end
  RELEASED // unused portion returned to the wallet (session ended under estimate)
  EXPIRED // swept by a background job (session never properly closed)
}

enum DataImportType {
  UG
  PG
}

enum DataImportStatus {
  RUNNING
  COMPLETED
  FAILED
  APPLIED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Which side of the marketplace an EnrollmentLead signed up for. Deliberately
/// its own enum rather than reusing UserRole — a lead is not a user, has no
/// ADMIN case, and shouldn't silently gain new members if UserRole grows.
enum EnrollmentLeadRole {
  ASPIRANT
  MENTOR
}

enum EnrollmentLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// Central identity record. One record per phone number.
/// Phone stored as bcrypt hash — never plaintext.
model User {
  id                 String             @id @default(uuid())
  phoneHash          String             @unique @map("phone_hash") @db.VarChar(128)
  displayName        String             @map("display_name") @db.VarChar(60)
  role               UserRole
  verificationStatus VerificationStatus @default(DRAFT) @map("verification_status")
  isActive           Boolean            @default(true) @map("is_active")
  isBanned           Boolean            @default(false) @map("is_banned")
  refreshTokenHash   String?            @map("refresh_token_hash") @db.VarChar(256)
  lastActiveAt       DateTime?          @map("last_active_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz

  // Relations
  profile               UserProfile?
  verificationRequests  VerificationRequest[] @relation("UserVerificationRequests")
  reviewedRequests      VerificationRequest[] @relation("ReviewerVerificationRequests")
  reviews               Review[]
  sentReports           Report[]              @relation("ReporterReports")
  actionedReports       Report[]              @relation("ActionedByReports")
  notifications         Notification[]
  pushTokens            PushToken[]
  mentorReviewsReceived MentorReview[]        @relation("MentorReviewsReceived")
  mentorReviewsAuthored MentorReview[]        @relation("MentorReviewsAuthored")
  wallet                Wallet?
  aspirantSessions      Session[]             @relation("AspirantSessions")
  mentorSessions        Session[]             @relation("MentorSessions")
  payoutRequests        PayoutRequest[]       @relation("MentorPayouts")
  processedPayouts      PayoutRequest[]       @relation("ProcessedPayouts")
  savedByAspirants      SavedMentor[]         @relation("SavedMentorTarget")
  savedMentors          SavedMentor[]         @relation("SavedMentorAspirant")
  blockedUsers          BlockedUser[]         @relation("BlockerRelation")
  blockedByUsers        BlockedUser[]         @relation("BlockedRelation")
  savedUniversities     SavedUniversity[]

  @@index([role])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("users")
}

/// Extended profile data — one-to-one with User.
/// Sensitive fields (real name) stored AES-256-GCM encrypted.
/// Mentor-facing fields (pricePerMinuteMinor, languages) are null/empty for
/// aspirants; set once a user opts into mentoring as role MENTOR.
model UserProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  realNameEncrypted        String?  @map("real_name_encrypted") @db.Text
  universityId             String?  @map("university_id")
  graduationYear           Int?     @map("graduation_year") @db.SmallInt
  yearOfStudy              Int?     @map("year_of_study") @db.SmallInt
  specialty                String?  @db.VarChar(100)
  bio                      String?  @db.VarChar(500)
  avatarKey                String?  @map("avatar_key") @db.VarChar(500)
  /// Aspirant-only onboarding fields — null/unused for mentors. Free text
  /// (not enums) since the exact option set is still being finalized with
  /// the product design; the mobile client renders them as dropdowns for
  /// UX but the backend doesn't constrain the value set yet.
  gender                   String?  @db.VarChar(30)
  state                    String?  @db.VarChar(100)
  city                     String?  @db.VarChar(100)
  qualification            String?  @db.VarChar(50)
  /// Free text, not FK'd to any picklist — only meaningful for a
  /// Medical-stream user (aspirant or mentor) whose qualification/degree
  /// isn't 12th/UG, e.g. "Paediatrics". Same pattern as the web enrollment
  /// form's EnrollmentLead.specialization.
  specialization           String?  @db.VarChar(100)
  /// Dual-purpose by role, same pattern as `specialty`: for an ASPIRANT this
  /// is their school-level stream (PCB/PCM/PCMB/Other); for a MENTOR it's
  /// their college field of study (Medical/Engineering/Law/etc — see
  /// kMentorStreams mobile-side). Widened from VARCHAR(20) since mentor
  /// values like "Commerce & Business" don't fit the aspirant-only length.
  stream                   String?  @db.VarChar(50)
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  /// Course the aspirant is pursuing/aiming for, e.g. "MBBS", "BDS" — distinct
  /// from `stream` (PCB/PCM at the school level).
  courseInterested         String?  @db.VarChar(50) @map("course_interested")
  /// Aspirant's preferred language for mentor communication — distinct from
  /// a mentor's own `languages` list (which is multi-select). Widened from
  /// VARCHAR(30) to fit multiple comma-joined picks, same fix as the web
  /// enrollment form's EnrollmentLead.preferredLanguage.
  preferredLanguage        String?  @db.VarChar(150) @map("preferred_language")
  preferredMentorshipTiming String? @db.VarChar(50) @map("preferred_mentorship_timing")
  /// Mentor's own choice to keep yearOfStudy/graduationYear off their public
  /// profile — only one of the two is ever set at a time (driven by
  /// currentStatus), so a single flag covers both. Same pattern as the web
  /// enrollment form's EnrollmentLead.yearInfoPrivate.
  yearInfoPrivate          Boolean  @default(false) @map("year_info_private")
  /// Target exams/colleges, e.g. ["NEET", "AIIMS Delhi"] — free-form tags,
  /// not FK'd to the University table (an aspirant's goal college may not
  /// exist in that table yet, or may be a general aspiration like "Any
  /// government college").
  goals                    String[] @default([])
  isMentorAvailable        Boolean  @default(false) @map("is_mentor_available")
  /// When isMentorAvailable was last set to true. Availability auto-expires
  /// after AVAILABILITY_TTL_HOURS so a mentor who toggles on and forgets
  /// doesn't advertise call availability indefinitely — the stored boolean
  /// stays true, but every read path treats it as false once stale (see
  /// isCallAvailable in availability.ts). Null means never toggled on.
  availabilitySetAt        DateTime? @map("availability_set_at") @db.Timestamptz
  /// Rate charged per minute of session time, in minor units (paise). Null until
  /// the mentor sets a rate; enforced non-null at the service layer before a
  /// mentor can accept bookings.
  pricePerMinuteMinor      Int?     @map("price_per_minute_minor")
  languages                String[] @default([])
  /// Mentor-only — days of the week the mentor is generally available for
  /// sessions, e.g. ["Monday", "Wednesday"]. Advisory only — not enforced
  /// at booking time (a booking can still be requested any day).
  availableDays            String[] @default([]) @map("available_days")
  /// Aspirant-only free tier: 2 free CHAT sessions before Uniminutes are
  /// required. Decremented on session accept, never goes below 0.
  freeChatsRemaining       Int      @default(2) @map("free_chats_remaining")
  /// Aspirant-only free tier: 10 free minutes of AUDIO_CALL time (stored in
  /// seconds for precise decrementing). Consumed before paid slot billing
  /// starts on a call.
  freeCallSecondsRemaining Int      @default(600) @map("free_call_seconds_remaining")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id])
  university University? @relation(fields: [universityId], references: [id])

  @@index([universityId])
  @@index([isMentorAvailable, universityId])
  @@map("user_profiles")
}

/// Master data for medical institutions. Admin-managed.
model University {
  id              String                   @id @default(uuid())
  name            String                   @db.VarChar(200)
  slug            String                   @unique @db.VarChar(200)
  type            UniversityType
  state           String                   @db.VarChar(100)
  /// Nullable because the authoritative NMC seat matrix has no city column —
  /// it is only derivable from the college name for ~69% of rows. Better an
  /// absent city than the state name masquerading as one; the mobile card
  /// already falls back to showing `state`.
  city            String?                  @db.VarChar(100)
  /// Primary academic field (Medical/Engineering/Law/etc — same picklist as
  /// UserProfile.stream, see kStreamOptions mobile-side). Null for older
  /// rows seeded before the multi-stream pivot; the Discover filter treats
  /// null as unfiltered/uncategorized rather than defaulting to Medical.
  stream          String?                  @db.VarChar(50)
  /// Degree levels offered — "UG" and/or "PG". Every college currently
  /// seeded is UG-only: the imported data source (NMC's MBBS seat matrix)
  /// covers undergraduate intake exclusively, no PG seat matrix has been
  /// imported yet. Modeled as an array (not a single value) because most
  /// real medical colleges offer both once PG data is added — a string
  /// field would need a breaking migration to add a second value later.
  levels          String[]                 @default(["UG"])
  nirfRank        Int?                     @map("nirf_rank") @db.SmallInt
  mbbsSeats       Int?                     @map("mbbs_seats") @db.SmallInt
  establishedYear Int?                     @map("established_year") @db.SmallInt
  website         String?                  @db.VarChar(300)
  description     String?                  @db.Text
  imageUrl        String?                  @map("image_url") @db.Text
  isActive        Boolean                  @default(true) @map("is_active")
  /// Full-text search vector — populated via SQL migration trigger on name/state/city
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  profiles             UserProfile[]
  programs             Program[]
  verificationRequests VerificationRequest[]
  reviews              Review[]
  savedByAspirants     SavedUniversity[]
  enrollmentLeads      EnrollmentLead[]

  @@index([state])
  @@index([type])
  @@index([stream])
  @@index([nirfRank])
  @@map("universities")
}

/// Degree programs offered at a university (e.g. MBBS, MD, MS, DNB).
model Program {
  id            String   @id @default(uuid())
  universityId  String   @map("university_id")
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  durationYears Int?     @map("duration_years") @db.SmallInt
  totalSeats    Int?     @map("total_seats") @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  university University @relation(fields: [universityId], references: [id])

  @@unique([universityId, name])
  @@index([universityId])
  @@map("programs")
}

/// Mentor identity verification submission.
/// One submission per user per document type; admin reviews before granting VERIFIED status.
model VerificationRequest {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  universityId String             @map("university_id")
  documentType DocumentType       @map("document_type")
  documentKey  String             @map("document_key") @db.VarChar(500)
  status       VerificationStatus @default(DRAFT)
  reviewedBy   String?            @map("reviewed_by")
  reviewNote   String?            @map("review_note") @db.VarChar(500)
  submittedAt  DateTime?          @map("submitted_at") @db.Timestamptz
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz

  user       User       @relation("UserVerificationRequests", fields: [userId], references: [id])
  university University @relation(fields: [universityId], references: [id])
  reviewer   User?      @relation("ReviewerVerificationRequests", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status, submittedAt])
  @@index([reviewedBy])
  @@map("verification_requests")
}

/// Multi-dimensional university review by a verified student or alumni.
model Review {
  id                     String                   @id @default(uuid())
  authorId               String                   @map("author_id")
  universityId           String                   @map("university_id")
  status                 ReviewStatus             @default(ACTIVE)
  overallRating          Int                      @map("overall_rating") @db.SmallInt
  facultyRating          Int?                     @map("faculty_rating") @db.SmallInt
  infrastructureRating   Int?                     @map("infrastructure_rating") @db.SmallInt
  clinicalExposureRating Int?                     @map("clinical_exposure_rating") @db.SmallInt
  campusLifeRating       Int?                     @map("campus_life_rating") @db.SmallInt
  placementsRating       Int?                     @map("placements_rating") @db.SmallInt
  pros                   String?                  @db.Text
  cons                   String?                  @db.Text
  body                   String?                  @db.Text
  helpfulCount           Int                      @default(0) @map("helpful_count")
  /// Full-text search vector — populated via SQL migration trigger on pros/cons/body
  searchVector           Unsupported("tsvector")? @map("search_vector")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz

  author     User       @relation(fields: [authorId], references: [id])
  university University @relation(fields: [universityId], references: [id])

  @@unique([authorId, universityId])
  @@index([universityId, createdAt(sort: Desc)])
  @@index([universityId, overallRating(sort: Desc)])
  @@index([authorId])
  @@map("reviews")
}

/// A rating + optional comment an aspirant leaves for a mentor after a
/// COMPLETED session. Distinct from `Review` (university-scoped, unrelated
/// to mentors). One review per session — enforced by the unique sessionId,
/// which also doubles as "have I already reviewed this session" for the
/// mobile client's prompt-once-per-session UI.
model MentorReview {
  id         String   @id @default(uuid())
  sessionId  String   @unique @map("session_id")
  mentorId   String   @map("mentor_id")
  aspirantId String   @map("aspirant_id")
  rating     Int      @db.SmallInt
  comment    String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  session  Session @relation(fields: [sessionId], references: [id])
  mentor   User    @relation("MentorReviewsReceived", fields: [mentorId], references: [id])
  aspirant User    @relation("MentorReviewsAuthored", fields: [aspirantId], references: [id])

  @@index([mentorId, createdAt(sort: Desc)])
  @@map("mentor_reviews")
}

/// An aspirant's saved/wishlisted mentor — pure bookmark, no booking
/// relationship implied. One row per (aspirantId, mentorId) pair.
model SavedMentor {
  id         String   @id @default(uuid())
  aspirantId String   @map("aspirant_id")
  mentorId   String   @map("mentor_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  aspirant User @relation("SavedMentorAspirant", fields: [aspirantId], references: [id])
  mentor   User @relation("SavedMentorTarget", fields: [mentorId], references: [id])

  @@unique([aspirantId, mentorId])
  @@index([mentorId])
  @@map("saved_mentors")
}

/// A user blocking another user — one-directional (blocker → blocked).
/// Enforced at session creation (SessionsService.create): neither party can
/// start a new chat/call session with someone who blocked them or whom they
/// blocked. Does not retroactively affect already-open sessions/chat
/// history — blocking only prevents new contact going forward.
model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker User @relation("BlockerRelation", fields: [blockerId], references: [id])
  blocked User @relation("BlockedRelation", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

/// An aspirant's saved/wishlisted university — pure bookmark, no
/// verification relationship implied. One row per (aspirantId,
/// universityId) pair.
model SavedUniversity {
  id           String   @id @default(uuid())
  aspirantId   String   @map("aspirant_id")
  universityId String   @map("university_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  aspirant   User       @relation(fields: [aspirantId], references: [id])
  university University @relation(fields: [universityId], references: [id])

  @@unique([aspirantId, universityId])
  @@index([universityId])
  @@map("saved_universities")
}

/// A single booking + its full lifecycle: request → accept/reject → (ring →)
/// connect → bill → end. One Session row per attempt — a re-request after a
/// FAILED/EXPIRED/REJECTED session creates a NEW row, never reuses one.
///
/// Billing invariant: only a server-observed connection event (Agora webhook
/// for AUDIO_CALL; explicit start-ack for CHAT) may transition status into
/// IN_PROGRESS, and only that transition starts the BullMQ billing clock.
/// Never trust a client-reported "call connected" message for billing.
model Session {
  id                 String        @id @default(uuid())
  aspirantId         String        @map("aspirant_id")
  mentorId           String        @map("mentor_id")
  type               SessionType
  status             SessionStatus @default(PENDING)
  /// Snapshot of the mentor's rate at booking time — later rate changes must
  /// never retroactively affect an in-flight or completed session.
  ratePerMinuteMinor Int           @map("rate_per_minute_minor")
  /// AUDIO_CALL only: the slot chosen at booking (5/10/20) — preserved
  /// regardless of whether it was free-tier or wallet-held, so the connect
  /// handler always knows how much to bill/decrement.
  callSlotMinutes    Int?          @map("call_slot_minutes")
  requestedAt        DateTime      @default(now()) @map("requested_at") @db.Timestamptz
  respondedAt        DateTime?     @map("responded_at") @db.Timestamptz
  /// Set only on a server-confirmed connection event — never client-reported.
  startedAt          DateTime?     @map("started_at") @db.Timestamptz
  endedAt            DateTime?     @map("ended_at") @db.Timestamptz
  /// Dual-client connect confirmation (interim measure until a real Agora
  /// server-side "user joined channel" webhook is configured — see
  /// SessionsService.confirmJoined). Billing only fires once BOTH are set,
  /// so neither party alone can trigger a charge.
  aspirantJoinedAt   DateTime?     @map("aspirant_joined_at") @db.Timestamptz
  mentorJoinedAt     DateTime?     @map("mentor_joined_at") @db.Timestamptz
  /// AUDIO_CALL: sum of committed/paid slot minutes (5/10/20, plus any +5
  /// "continue" extensions) — this is what was CHARGED, not necessarily the
  /// actual connected duration (a student-initiated early hangup or a
  /// mid-call cutoff still bills the full committed slot).
  billedMinutes      Int           @default(0) @map("billed_minutes")
  totalCostMinor     Int           @default(0) @map("total_cost_minor")
  agoraChannelName   String?       @map("agora_channel_name") @db.VarChar(100)
  streamChannelId    String?       @map("stream_channel_id") @db.VarChar(100)
  /// NORMAL | NO_ANSWER | DROPPED | MENTOR_DROPPED | BALANCE_EXHAUSTED |
  /// CANCELLED | REJECTED. MENTOR_DROPPED still bills the full slot per
  /// product decision — the aspirant gets a Report action, and any refund is
  /// manual/admin-issued (LedgerEntryType.REFUND), never automatic.
  endReason          String?       @map("end_reason") @db.VarChar(30)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  aspirant      User          @relation("AspirantSessions", fields: [aspirantId], references: [id])
  mentor        User          @relation("MentorSessions", fields: [mentorId], references: [id])
  holds         WalletHold[]
  ledgerEntries LedgerEntry[]
  mentorReview  MentorReview?

  @@index([aspirantId, status])
  @@index([mentorId, status])
  @@index([status, requestedAt])
  @@map("sessions")
}

/// One wallet per user. balanceMinor is a CACHE derived from LedgerEntry rows —
/// it must only ever be written in the same DB transaction as the ledger insert
/// that produced it. A nightly reconciliation job recomputes balance from the
/// ledger and alerts on drift.
model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  balanceMinor Int      @default(0) @map("balance_minor")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User          @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]
  holds         WalletHold[]

  @@map("wallets")
}

/// Append-only transaction log — the source of truth for wallet balance.
/// NEVER UPDATE or DELETE a row; corrections are new compensating entries.
/// idempotencyKey is unique and required on every insert: Razorpay webhooks
/// retry, and BullMQ billing ticks retry, so every credit/debit must be safe
/// to attempt more than once without double-applying.
model LedgerEntry {
  id                String          @id @default(uuid())
  walletId          String          @map("wallet_id")
  type              LedgerEntryType
  /// Positive = credit, negative = debit. Minor units (paise / Uniminutes).
  amountMinor       Int             @map("amount_minor")
  balanceAfterMinor Int             @map("balance_after_minor")
  sessionId         String?         @map("session_id")
  idempotencyKey    String          @unique @map("idempotency_key")
  note              String?         @db.VarChar(300)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  wallet  Wallet   @relation(fields: [walletId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([walletId, createdAt])
  @@index([sessionId])
  @@map("ledger_entries")
}

/// Authorization hold placed at session start so a user can't double-spend the
/// same balance across concurrent sessions. Placed for the aspirant's full
/// spendable balance (or an estimated session cost, whichever is smaller);
/// consumed via provisional per-minute SESSION_DEBIT entries as the call
/// progresses; the backend force-ends the session when the hold is exhausted.
/// Expired (never-closed) holds are swept by a BullMQ job.
model WalletHold {
  id          String     @id @default(uuid())
  walletId    String     @map("wallet_id")
  sessionId   String     @map("session_id")
  amountMinor Int        @map("amount_minor")
  status      HoldStatus @default(ACTIVE)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  wallet  Wallet  @relation(fields: [walletId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([walletId, status])
  @@index([status, expiresAt])
  @@map("wallet_holds")
}

/// Manual, admin-triggered mentor payout. Disbursement automation is
/// deliberately deferred (architecture review) — a human reviews and
/// approves every payout before funds move. amountMinor is derived from
/// SESSION_CREDIT ledger entries for the given period at request time.
model PayoutRequest {
  id            String       @id @default(uuid())
  mentorId      String       @map("mentor_id")
  amountMinor   Int          @map("amount_minor")
  status        PayoutStatus @default(PENDING)
  periodStart   DateTime     @map("period_start") @db.Timestamptz
  periodEnd     DateTime     @map("period_end") @db.Timestamptz
  bankReference String?      @map("bank_reference") @db.VarChar(200)
  processedBy   String?      @map("processed_by")
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  mentor    User  @relation("MentorPayouts", fields: [mentorId], references: [id])
  processor User? @relation("ProcessedPayouts", fields: [processedBy], references: [id])

  @@index([mentorId, status])
  @@index([status, createdAt])
  @@map("payout_requests")
}

/// User-submitted flag on any content. Polymorphic via targetType + targetId.
model Report {
  id          String           @id @default(uuid())
  reporterId  String           @map("reporter_id")
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  reason      ReportReason
  description String?          @db.VarChar(500)
  status      ReportStatus     @default(OPEN)
  actionedBy  String?          @map("actioned_by")
  resolution  String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  reporter       User  @relation("ReporterReports", fields: [reporterId], references: [id])
  actionedByUser User? @relation("ActionedByReports", fields: [actionedBy], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([actionedBy])
  @@map("reports")
}

/// In-app notification record linked to a user.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

/// One run of the "refresh college data" admin tool (see universities/data-import
/// module). Re-runs the same capture pipeline used to originally seed the
/// dataset — NMC's MBBS seat-matrix PDF for UG, MCC's PG institute list for
/// PG — and stores a diff against the live DB rather than writing directly:
/// an admin reviews `diffJson` and only committed rows via the apply
/// endpoint actually reach University, so a source-site change or a stale
/// admin edit never gets silently overwritten.
model DataImportJob {
  id          String            @id @default(uuid())
  type        DataImportType
  status      DataImportStatus  @default(RUNNING)
  /// { added: [...], changed: [...], unchanged: number, sourceCount: number }
  /// — populated once capture completes; null while RUNNING.
  diffJson    Json?
  /// Populated only after /apply — which of diffJson's rows the admin
  /// actually approved, so a second apply call can't silently redo it.
  appliedJson Json?
  error       String?           @db.Text
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime?         @map("completed_at") @db.Timestamptz
  appliedAt   DateTime?         @map("applied_at") @db.Timestamptz
  appliedBy   String?           @map("applied_by")

  @@index([type, startedAt(sort: Desc)])
  @@map("data_import_jobs")
}

/// FCM device token — a user can have several (multiple devices). Tokens are
/// pruned automatically when Firebase reports them as no-longer-registered.
model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(400)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_tokens")
}

/// A pre-registration captured from the public marketing website, before the
/// person has any account at all. Deliberately standalone — NO relation to
/// User — because the whole point is collecting interest from people who
/// haven't signed up and may never do so. An admin later converts a lead into
/// a real ASPIRANT/MENTOR account, at which point `convertedUserId` is set and
/// the lead is kept as a historical record rather than deleted.
///
/// Field names intentionally mirror `UserProfile` one-for-one (gender, state,
/// city, stream, qualification, courseInterested, preferredLanguage,
/// preferredMentorshipTiming, goals, languages, availableDays, yearOfStudy,
/// graduationYear) so that conversion is a straight column copy instead of a
/// re-parsing exercise. Values are unconstrained free text for the same reason
/// UserProfile's are: the web form renders them as dropdowns for UX, but the
/// picklists are still being finalised and a lead must never be rejected
/// because a marketing page drifted ahead of the enum.
///
/// NOTE on `phone`: every other table stores phones as a bcrypt hash
/// (`User.phoneHash`) and never in plaintext. Leads are the deliberate
/// exception — an unconverted lead exists precisely so someone can be called
/// or messaged back, which a hash makes impossible. Treat this table as
/// contact data: it is ADMIN-read-only over the API, never included in any
/// public or user-facing response projection.
model EnrollmentLead {
  id     String               @id @default(uuid())
  role   EnrollmentLeadRole
  status EnrollmentLeadStatus @default(NEW)

  /// Contact details — the only fields required of both roles.
  fullName String  @map("full_name") @db.VarChar(120)
  phone    String  @db.VarChar(20)
  email    String? @db.VarChar(200)

  /// Shared profile fields (both roles).
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?   @db.VarChar(30)
  state       String?   @db.VarChar(100)
  city        String?   @db.VarChar(100)
  stream      String?   @db.VarChar(50)

  /// Aspirant-only.
  qualification             String?  @db.VarChar(50)
  courseInterested          String?  @map("course_interested") @db.VarChar(50)
  /// Widened from VARCHAR(30)/(50) to fit multiple comma-joined picks — the
  /// web form allows multi-select on both, same "join into one string"
  /// pattern as the mobile-facing UserProfile columns of the same name.
  preferredLanguage         String?  @map("preferred_language") @db.VarChar(150)
  preferredMentorshipTiming String?  @map("preferred_mentorship_timing") @db.VarChar(150)

  /// Mentor-only. `universityId` is set when the person picked an existing
  /// college from the dropdown; `collegeName` always holds the raw text so a
  /// college missing from the University table doesn't lose the answer.
  alias          String?  @db.VarChar(60)
  universityId   String?  @map("university_id")
  collegeName    String?  @map("college_name") @db.VarChar(200)
  /// Widened from VARCHAR(20): a picklist value fits easily, but "Others"
  /// reveals a free-text field on the form (same pattern as `stream`), and
  /// a typed degree name can run well past 20 characters.
  degree         String?  @db.VarChar(50)
  /// Free text, not FK'd to any picklist — only meaningful (and only shown
  /// on the form) for a Medical-stream mentor whose degree isn't UG, e.g.
  /// "Paediatrics" for an MD/MS. Building a real specialization-per-degree
  /// taxonomy was deliberately deferred (see the automation-roadmap
  /// discussion); this captures the answer either way.
  specialization String?  @db.VarChar(100)
  currentStatus  String?  @map("current_status") @db.VarChar(30)
  yearOfStudy    Int?     @map("year_of_study") @db.SmallInt
  graduationYear Int?     @map("graduation_year") @db.SmallInt
  /// Mentor's own choice to keep yearOfStudy/graduationYear off their public
  /// profile once converted — only one of the two is ever set at a time
  /// (driven by currentStatus), so a single flag covers both.
  yearInfoPrivate Boolean @default(false) @map("year_info_private")
  languages      String[] @default([])
  availableDays  String[] @default([]) @map("available_days")

  /// Mentor college-ID upload — same Supabase bucket and signed-URL read path
  /// as VerificationRequest, but stored here so it survives independently of
  /// whether the lead is ever converted.
  documentType DocumentType? @map("document_type")
  documentKey  String?       @map("document_key") @db.VarChar(500)

  /// Ops/CRM fields — admin-only, never accepted from the public endpoint.
  convertedUserId String? @unique @map("converted_user_id")
  adminNote       String? @map("admin_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  university University? @relation(fields: [universityId], references: [id])

  /// One submission per phone per side of the marketplace: re-submitting the
  /// same form updates the existing lead rather than creating a duplicate,
  /// but the same person may legitimately register as both an aspirant and a
  /// mentor.
  @@unique([role, phone])
  @@index([status, createdAt(sort: Desc)])
  @@index([role, createdAt(sort: Desc)])
  @@map("enrollment_leads")
}
