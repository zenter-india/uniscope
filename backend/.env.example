# ─────────────────────────────────────────────────────────────────────────────
# Uniscope Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_NAME=Uniscope API
API_PREFIX=api/v1

# Error tracking (Sentry) — optional. Leave unset and the SDK stays a
# complete no-op (see src/instrument.ts) — nothing else in the app depends
# on it. Get a DSN from a free Sentry project: sentry.io → Projects →
# Create Project → Node.js/Express → Client Keys (DSN).
# SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Database (Supabase)
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Firebase (FCM)
FIREBASE_PROJECT_ID=uniscope-xxxxx
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
FIREBASE_DISABLED=false
# Alternative to the file path above, for hosts with no file-upload/secret-mount
# feature (e.g. Railway): base64-encode the key JSON and set it here instead.
# Generate with: base64 -i firebase-service-account.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# JWT
JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=315360000

# Upstash Redis
# Get from: console.upstash.com → Redis → Connect → ioredis
REDIS_URL=rediss://:[password]@[endpoint].upstash.io:6379

# OTP provider — one of: mock | twilio | msg91
OTP_PROVIDER_TYPE=twilio

# Twilio Verify (only used when OTP_PROVIDER_TYPE=twilio)
# Get from: console.twilio.com → Verify → Services
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxx

# MSG91 OTP (only used when OTP_PROVIDER_TYPE=msg91) — cheaper per-SMS than
# Twilio for Indian numbers. Get MSG91_AUTH_KEY from the MSG91 dashboard
# (Settings → API); MSG91_TEMPLATE_ID must be a DLT-approved OTP template
# (India SMS regulatory requirement, not MSG91-specific — see
# msg91.com/help/dlt-registration-in-india).
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Real-name encryption (UserProfile.realNameEncrypted) — AES-256-GCM key,
# must be a 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROFILE_ENCRYPTION_KEY=

# Ops alerts — optional. Unset means alerts are silently skipped (new-lead
# and daily-digest Slack posts just don't fire; nothing else depends on it).
# Get from: Slack → your workspace → Apps → Incoming Webhooks → Add to Slack
SLACK_WEBHOOK_URL=

# Apple In-App Purchase — wallet topups on iOS only (Android keeps Razorpay;
# see the Business model decisions in CLAUDE.md for why both coexist).
# Optional/soft-defaulted: unset means WalletService's Apple verifier is
# never constructed, and Android is unaffected either way.
# APPLE_BUNDLE_ID: App Store Connect → App Information → Bundle ID.
APPLE_BUNDLE_ID=com.uniscope.uniscopeMobile
# APPLE_ISSUER_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY: App Store Connect →
# Users and Access → Integrations → App Store Connect API → create a key
# with App Store Server API access. The .p8 file can only be downloaded
# once — save it immediately. Paste the .p8 file's contents here with
# literal `\n` in place of real newlines (apple.config.ts unescapes them).
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 'xcode' (local StoreKit Testing config, no sandbox account needed) |
# 'sandbox' (real TestFlight/sandbox Apple ID) | 'production'.
APPLE_ENVIRONMENT=production
# The numeric App Store app id — App Store Connect → App Information →
# General Information → "Apple ID". Not needed for xcode/sandbox testing.
APPLE_APP_APPLE_ID=

# Railway public API — powers the admin panel's Integrations/Usage page
# (current billing-period usage + Railway's own end-of-period estimate).
# Optional: if any of the three is unset, the integration just reports
# "not configured" rather than breaking anything.
# Generate a Workspace token (not Account — too broad; not Project — can't
# read workspace-level usage) at https://railway.com/account/tokens,
# workspace = "Uniscope Project".
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_WORKSPACE_ID=
