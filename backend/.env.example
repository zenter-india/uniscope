# ─────────────────────────────────────────────────────────────────────────────
# Uniscope Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_NAME=Uniscope API
API_PREFIX=api/v1

# Database (Supabase)
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Firebase (FCM)
FIREBASE_PROJECT_ID=uniscope-xxxxx
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
FIREBASE_DISABLED=false

# JWT
JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Upstash Redis
# Get from: console.upstash.com → Redis → Connect → ioredis
REDIS_URL=rediss://:[password]@[endpoint].upstash.io:6379

# Twilio Verify (OTP)
# Get from: console.twilio.com → Verify → Services
OTP_PROVIDER_TYPE=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxx
