# Copy to .env.local and fill in. Next.js loads .env.local automatically.

# Backend base URL for the browser (future API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Admin sign-in credentials (single-admin skeleton — replace with real
# identity provider in a later sprint)
ADMIN_EMAIL=admin@uniscope.app
ADMIN_PASSWORD=change-me-in-local-env

# Secret used to sign the admin session cookie (generate with: openssl rand -base64 32)
ADMIN_SESSION_SECRET=generate-a-long-random-string
