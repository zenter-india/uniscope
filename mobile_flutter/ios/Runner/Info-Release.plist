<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Uniscope</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>uniscope_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Uniscope needs microphone access for audio calls with mentors.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Uniscope needs photo access to upload your verification document.</string>
	<key>NSCameraUsageDescription</key>
	<string>Uniscope needs camera access to take a photo of your ID for mentor verification.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Uniscope uses Bluetooth to route call audio to a connected headset or car speaker.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Uniscope does not use your location. This permission is only requested by the photo picker used for uploading verification documents.</string>
	<!-- Release/Profile builds use this plist (see project.pbxproj's
	     INFOPLIST_FILE per config) instead of the shared Info.plist
	     specifically to NOT carry NSAllowsArbitraryLoads — that ATS
	     exception is a real App Store review risk and a genuine security
	     weakening, and production only ever talks to the https:// Railway
	     URL, which needs no exception. It exists in the plain Info.plist
	     (Debug only) purely so a developer can point a physical device at
	     a LAN http:// backend (dart-define API_URL=http://192.168.x.x:...)
	     while iterating locally. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- `audio` re-added 2026-10-03. It was removed 2026-09-16 per an
		     Apple App Store rejection (Guideline 2.5.4: no feature that
		     actually needed persistent background audio, and iOS call
		     audio was never confirmed working end-to-end at the time).
		     That condition no longer holds: the real cause of every iOS
		     call failure was found and fixed the same day (Xcode's
		     Release-archive STRIP_STYLE=all was deleting the
		     Iris_InitDartApiDL symbol agora_rtc_engine's Dart<->native
		     bridge needs at runtime — see "iOS published to App Store,
		     call still not connecting" in CLAUDE.md for the full
		     root-cause writeup), and a real two-device call was confirmed
		     connecting on real iPhones the same day. Audio calls are this
		     app's core paid feature, which is now a genuine, demonstrable
		     justification for this background mode. Before re-submitting
		     for review, record a short screen recording showing a live
		     call continuing while the app is backgrounded, per Apple's own
		     rejection instructions, and attach it to the resolution reply.
		     Deliberately still NOT adding `voip` — real PushKit/CallKit
		     ringing was built and then reverted (2026-09-13, client decision:
		     no ringtone needed, plain notifications are enough) specifically
		     because it required declaring FOREGROUND_SERVICE_PHONE_CALL on
		     Android, which triggers extra Play Console review burden the
		     client didn't want. Apple review also rejects a `voip`
		     declaration with no real VoIP-push usage behind it. -->
		<string>audio</string>
	</array>
</dict>
</plist>
