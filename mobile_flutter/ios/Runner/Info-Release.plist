<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Uniscope</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>uniscope_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Uniscope needs microphone access for audio calls with mentors.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Uniscope needs photo access to upload your verification document.</string>
	<key>NSCameraUsageDescription</key>
	<string>Uniscope needs camera access to take a photo of your ID for mentor verification.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Uniscope uses Bluetooth to route call audio to a connected headset or car speaker.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Uniscope does not use your location. This permission is only requested by the photo picker used for uploading verification documents.</string>
	<!-- Release/Profile builds use this plist (see project.pbxproj's
	     INFOPLIST_FILE per config) instead of the shared Info.plist
	     specifically to NOT carry NSAllowsArbitraryLoads — that ATS
	     exception is a real App Store review risk and a genuine security
	     weakening, and production only ever talks to the https:// Railway
	     URL, which needs no exception. It exists in the plain Info.plist
	     (Debug only) purely so a developer can point a physical device at
	     a LAN http:// backend (--dart-define=API_URL=http://192.168.x.x:...)
	     while iterating locally. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- `audio` was removed 2026-09-16 per Apple App Store rejection
		     (Guideline 2.5.4): review found no feature that actually needs
		     persistent background audio, and iOS call audio was never
		     confirmed working end-to-end anyway (see the "iOS call audio
		     investigated" note elsewhere in this file — real audio issues
		     were still unresolved when this was added). If background-audio
		     continuity during a backgrounded call is ever built and verified
		     working on a real device, re-add `audio` here (and to the
		     Debug-only Info.plist) and reply to Apple's review message with
		     a screen recording proving it, per their own instructions.
		     Deliberately NOT adding `voip` either — real PushKit/CallKit
		     ringing was built and then reverted (2026-09-13, client decision:
		     no ringtone needed, plain notifications are enough) specifically
		     because it required declaring FOREGROUND_SERVICE_PHONE_CALL on
		     Android, which triggers extra Play Console review burden the
		     client didn't want. Apple review also rejects a `voip`
		     declaration with no real VoIP-push usage behind it. -->
	</array>
</dict>
</plist>
