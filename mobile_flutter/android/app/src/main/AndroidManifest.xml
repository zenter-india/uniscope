<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Agora's "full" SDK variant transitively bundles a screen-sharing
         module that declares FOREGROUND_SERVICE_MEDIA_PROJECTION — the app
         never does screen sharing (audio calls only), so this strips it
         from the merged manifest rather than declaring a false "why" for it
         in the Play Console foreground-service-permissions questionnaire. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove"/>
    <!-- Required for ImageSource.camera (image_picker) — the "Take a photo"
         option on ID/document verification uploads. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- CallForegroundService: keeps the Agora audio connection + call
         timer alive while the app is backgrounded, with an ongoing
         notification (see CallForegroundService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Lets the "Calls" notification channel vibrate alongside its ringtone
         (flutter_local_notifications enableVibration / defaultVibrateTimings). -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Declaring the CAMERA permission makes Play Store assume a camera is
         required unless told otherwise — a mentor without one can still
         verify via the gallery option, so don't gate installability on it. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="Uniscope"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Testing whether Impeller (Flutter's default Android renderer) is
             causing custom-font glyph distortion reported on a Samsung
             device — Skia is the older, more broadly-tested backend. Remove
             this override if Impeller turns out not to be the cause. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets url_launcher open the dialer for the Help Centre "Call us"
             action on Android 11+ (package visibility). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
